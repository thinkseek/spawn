[Unit]
Description=Spawn: daily restore drill of the transcript archive and the mission repositories: the newest bundle chain restored into scratch, checked against its record and live, and recorded (deploy/backup)
After=spawn-backup-bundle.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/spawn-rsi/bin/spawn backup restore-drill
# The bundle's environment, so the drill's records (backup.drilled.transcripts
# and backup.drilled.missions) go to the store the bundle records go to.
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=SPAWN_WORKSPACE_ROOT=%h/.local/share/spawn-rsi/ws
Environment=PATH=%h/.local/share/spawn-rsi/bin:/usr/local/bin:/usr/bin:/bin
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
# The scratch directory is made under /data/tmp (the drill's default; never
# under $HOME, $SPAWN_LIVE or the workspace root) and removed by the drill at
# the end; a run killed part way leaves it, named spawn-restore-drill-*.
# A failed drill (exit 1) is the record's and a person's; 2 is a drill that
# cannot run (settings, the key file, the store): neither is a retry's.
Restart=on-failure
RestartSec=1h
RestartPreventExitStatus=1 2 78 243
TimeoutStartSec=1h
# Each bundle of the chain is fetched into memory before it is decrypted and
# unpacked (a full one ~90 MB); the restored files go to disk.
MemoryMax=1G
Nice=15
IOSchedulingClass=idle
