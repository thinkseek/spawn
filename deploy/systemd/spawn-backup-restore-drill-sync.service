[Unit]
Description=Spawn: daily restore drill of the fleet's notes folder alone (objective 217): the notes part restored from the newest bundle chain into the drill's own folder, each file the newest manifest's sha256, compared read only with the folder the record names, the drill's folder removed, and recorded as backup.drilled.sync (deploy/backup)
After=spawn-backup-bundle.service

[Service]
Type=oneshot
# --only sync: from each bundle only manifest.json, sync/manifest.json and
# sync/files/* are unpacked, into the drill's own folder. The notes folder
# (/var/tmp/spawn/sync, as the bundle's record names it) is only read:
# nothing is written to, created in or removed from it.
ExecStart=%h/.local/share/spawn-rsi/bin/spawn backup restore-drill --only sync
# The bundle's environment, so the record goes to the store the bundle
# records go to; R2 is only read (GET), never written.
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=SPAWN_WORKSPACE_ROOT=%h/.local/share/spawn-rsi/ws
Environment=PATH=%h/.local/share/spawn-rsi/bin:/usr/local/bin:/usr/bin:/bin
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
# The drill folder is made under /data/tmp (never under $HOME, $SPAWN_LIVE,
# the workspace root or the notes folder); the drill refuses (exit 2) when
# unpacking would leave /data/tmp's file system under 40 GB free. A run
# killed part way leaves its folder, named spawn-restore-drill-*. Exit 1 is
# a failed drill (the record's and a person's), 2 a drill that cannot run:
# neither is a retry's.
Restart=on-failure
RestartSec=1h
RestartPreventExitStatus=1 2
TimeoutStartSec=1h
MemoryMax=1G
Nice=15
IOSchedulingClass=idle
