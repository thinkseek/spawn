[Unit]
Description=Spawn: daily restore drill — the newest dump restored into a scratch database and compared with its record (deploy/backup)
After=spawn-backup.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/spawn-rsi/bin/spawn backup verify
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=SPAWN_WORKSPACE_ROOT=%h/.local/share/spawn-rsi/ws
Environment=PATH=%h/.local/share/spawn-rsi/bin:/usr/local/bin:/usr/bin:/bin
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
# The drill refuses (exit 2) without SPAWN_BACKUP_DRILL_DATABASE_URL in
# spawn.env: a disposable server (the fleet's test database), never the live
# one. A failed drill (exit 1) is the record's and a person's, not a retry's.
Restart=on-failure
RestartSec=1h
RestartPreventExitStatus=1 2
TimeoutStartSec=1h
# The object is fetched into memory before it is decrypted and unpacked: the
# dump is ~10 MB, the bundle tens of MB (a full one ~90 MB). A cap keeps a
# runaway fetch from taking the host's memory with it.
MemoryMax=1G
Nice=10
IOSchedulingClass=idle
