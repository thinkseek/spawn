[Unit]
Description=Spawn: restore each account's newest session backup into scratch and check it (deploy/session-backup.sh drill)

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/spawn/session-backup.sh drill
Environment=SPAWN_SESSION_BACKUP_ROOT=/var/backups/spawn-sessions
# The versions' owner: root only starts it and each account (setpriv), and
# writes nothing itself (deploy/session-backup.sh, "Who does what").
Environment=SPAWN_SESSION_BACKUP_USER=spawn-backup
Environment=SPAWN_SESSION_HOMES=/home/ckl
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/spawn-sessions
# The drill restores into TMPDIR: the unit's own /tmp, gone with the unit.
PrivateTmp=yes
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
