[Unit]
Description=Spawn: local relay to the hosted TypeSafe Jev API
After=network-online.target

[Service]
EnvironmentFile=%h/.config/spawn/typesafe.env
Environment=https_proxy=http://127.0.0.1:10801
Environment=JEV_RELAY_ADDRESS=127.0.0.1:8790
ExecStart=/usr/bin/python3 -I %h/.local/share/spawn-rsi/bin/jev-relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
