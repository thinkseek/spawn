[Unit]
Description=Spawn fleet test PostgreSQL (the engines' SPAWN_TEST_DATABASE_URL; never the gates' server)
# Created once by deploy/fleet-test-db.sh.
ConditionPathExists=%h/.local/share/spawn-rsi/fleet-pg/data/PG_VERSION

[Service]
# Built with systemd support: it says when it accepts connections.
Type=notify
ExecStart=/usr/lib/postgresql/16/bin/postgres -D %h/.local/share/spawn-rsi/fleet-pg/data
ExecReload=/bin/kill -HUP $MAINPID
# SIGINT is PostgreSQL's fast shutdown; only the postmaster is signalled,
# it stops its backends.
KillSignal=SIGINT
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
# Test data only: a heavy test run must not starve the live server or a gate.
Nice=10

[Install]
WantedBy=default.target
