[Unit]
Description=Spawn: hourly PostgreSQL backup to R2

[Timer]
# Every hour, at :00 with up to 5 minutes of jitter (a dump takes seconds;
# the jitter keeps runs apart when several hosts share a proxy).
OnCalendar=*-*-* *:00:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
