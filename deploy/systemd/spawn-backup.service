[Unit]
Description=Spawn: hourly encrypted dump of the event log to Cloudflare R2, locked against deletion (deploy/backup)
# The dump records through the live database; nothing else must run first.
After=network-online.target
# A failed run (proxy or network down) is retried every 15 minutes
# (Restart= below) until one succeeds: a run at 04:00 that fails and succeeds
# at 04:15 is still the hour's copy. No start limit (objective 238). The
# limit counted the timer's hourly starts with the retries, so with the
# 2 h / 3 starts it had, one outage used it up. On 2026-11-19 that was the
# 17:05 run, then 18:03 and 18:19 failing. systemd then refused the 18:34
# retry and the 19:02 timer run ("Start request repeated too quickly"), and
# R2 had no dump from 17:05 to 20:20. Exit 3 and 4 are still never retried.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# The binary's own arm (crates/spawn-cli/src/backup.rs), installed as
# bin/spawn like every other command.
ExecStart=%h/.local/share/spawn-rsi/bin/spawn backup dump
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=SPAWN_WORKSPACE_ROOT=%h/.local/share/spawn-rsi/ws
Environment=PATH=%h/.local/share/spawn-rsi/bin:/usr/local/bin:/usr/bin:/bin
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
Restart=on-failure
RestartSec=15min
# 3 = the dump failed the plausibility check and went to postgres/suspect/
# (a retry would upload the same suspect dump); 4 = the R2 limit stopped the
# hourly copy (nothing written, and a retry changes nothing either): both
# are the record's job, and `systemctl --user --failed` names the unit.
RestartPreventExitStatus=3 4
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
