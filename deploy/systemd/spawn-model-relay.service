[Unit]
Description=Spawn: local relay from the engines to their model APIs (DeepSeek, the gateway)
After=network-online.target

[Service]
# DEEPSEEK_API_KEY (0600, under ~/.config/spawn, which engines may not read:
# CREDENTIAL_DENY). The key stays in this process. Until Keep delivers it
# (/run/keep, LoadCredential, as spawn-jev-relay), this file is the source.
EnvironmentFile=%h/.config/spawn/model-relay.env
# Both upstreams are reached directly from this host: no local proxy.
Environment=MODEL_RELAY_ADDRESS=127.0.0.1:8791
# The gateway every non-DeepSeek model goes to: by default the
# env.ANTHROPIC_BASE_URL of ~/.claude/settings.json, read at start.
# Environment=MODEL_RELAY_UPSTREAM=https://gateway.example
ExecStart=/usr/bin/python3 -I %h/.local/share/spawn-rsi/bin/model-relay.py
Restart=always
RestartSec=3
# 78/243 = Keep LoadCredential file missing or invalid (Wave K4): do not retry-loop.
RestartPreventExitStatus=78 243

[Install]
WantedBy=default.target
