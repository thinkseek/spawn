[Unit]
Description=Spawn: Keep-delivered credentials present, loaded and accepted (scripts/keep/credential-health.sh)

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/spawn-rsi
ExecStart=/bin/bash %h/.local/share/spawn-rsi/controllers/spawn/scripts/keep/credential-health.sh
# For the owner alert only (spawn_alert_record, as the nightly's): the check reads no credential.
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=2min
