[Unit]
Description=Spawn fleet: Bridge + Observer + supervisor liveness (never stops on its own)
After=spawn-jev-relay.service spawn-model-relay.service docker.service
Wants=spawn-jev-relay.service spawn-model-relay.service

[Service]
# Not the owner's checkout: nothing live reads it (deploy/deploy.sh).
WorkingDirectory=%h/.local/share/spawn-rsi
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=PATH=%h/.cargo/bin:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Engines talk to loopback relays or direct egress; no local proxy listens on 10801.
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
Environment=SPAWN_PROGRAM=%h/.local/share/spawn-rsi/bin/spawn
# Free disk under 40 GiB is an alert (objective 204; the owner's core metric set).
Environment=SPAWN_ALERT_DISK_LOW_GB=40 SPAWN_ALERT_DISK_OK_GB=45
# A stand-in location tool is for a gate's sandbox only (175 R6, cc-astra
# A81): the live loop never inherits one, whatever spawn.env or the
# manager's environment holds.
UnsetEnvironment=SPAWN_GATE_SANDBOX SPAWN_ARCHIVE_LOCATIONS_TOOL
# A new binary migrates the schema before anything reads it.
ExecStartPre=%h/.local/share/spawn-rsi/bin/spawn init-db
ExecStart=%h/.local/share/spawn-rsi/bin/spawn loop
# The agents' Herdr terminal server (`spawn-hc` / `herdr`) lives in this cgroup. Restarting the loop must not
# kill the agents: the next loop recovers their executions from the event
# log. KillMode=process signals only the main process, so the main process
# must be `spawn loop` itself; a wrapper script would leave the old loop
# running beside the new one.
KillMode=process
# SIGTERM ends the loop after its pass, once its queued branch pushes are
# made (a flush waits up to 30 s for pushes in flight, then pushes the rest).
TimeoutStopSec=120
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
