[Unit]
Description=Spawn RSI controller (spawn rsi-loop): one workload of the fleet
After=spawn-loop.service docker.service
Wants=spawn-loop.service

[Service]
WorkingDirectory=%h/projects/Spawn
EnvironmentFile=%h/.local/share/spawn-rsi/spawn.env
Environment=PATH=%h/.cargo/bin:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=http_proxy=http://127.0.0.1:10801 https_proxy=http://127.0.0.1:10801 HTTP_PROXY=http://127.0.0.1:10801 HTTPS_PROXY=http://127.0.0.1:10801
Environment=no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
Environment=SPAWN_PROGRAM=%h/.local/share/spawn-rsi/bin/spawn
ExecStart=%h/.local/share/spawn-rsi/bin/spawn rsi-loop
Restart=on-failure
RestartSec=10
# Exit 2 is the RSI halt: a decision for a human. It stops RSI only.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
