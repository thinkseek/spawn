#!/bin/sh
# Gate build hook (scripts/rsi/gate.sh): build the tree's `spawn` binary, plus
# `spawn-hc` when the tree defines it (trees from before `crates/spawn-hc`
# existed build `spawn` only).
# The target directory is pinned to the tree, so two trees never share one
# and an inherited CARGO_TARGET_DIR cannot swap the binary under test.
set -eu
if grep -q '^name = "spawn-hc"' crates/spawn-hc/Cargo.toml 2>/dev/null; then
  CARGO_TARGET_DIR="$PWD/target" cargo build -q --bin spawn --bin spawn-hc
else
  CARGO_TARGET_DIR="$PWD/target" cargo build -q --bin spawn
fi
